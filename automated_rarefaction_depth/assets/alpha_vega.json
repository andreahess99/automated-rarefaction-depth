{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 900,
  "height": 400,
  "padding": { "left": 10, "bottom": 10, "right": 40}, 
  "signals": [
    {
      "name": "groupField",
      "value": "sample",
      "bind": {
        "input": "select", 
        "options": ["sample", "treatment", "condition", "group"], 
        "name": "Group by "
      }
    },
    {
      "name": "metricField",
      "init": "data('raw')[0] ? data('raw')[0].metric : null",
      "bind": {
        "input": "select", 
        "options": ["observed_features", "shannon", "braycurtis", "jaccard"], 
        "name": "Metric "
      }
    },
    {
      "name": "knee_point",
      "update": "length(data('selected_knee')) > 0 ? data('selected_knee')[0].knee : null"
    },
    {
      "name": "x_axis_title",
      "value": "Sequencing Depth" 
    },
    {
      "name": "hidden_groups",
      "value": ",",
      "on": [
        {
          "events": "@group_legend_symbols:click, @group_legend_labels:click",
          "update": "indexof(hidden_groups, ',' + datum.value + ',') >= 0 ? replace(hidden_groups, ',' + datum.value + ',', ',') : hidden_groups + datum.value + ','"
        },
        {
          "events": {"signal": "groupField"},
          "update": "','"
        },
        {
          "events": "@select_all_btn:click",
          "update": "toggle_all_state ? ',' + join(pluck(data('legend_groups'), 'group'), ',') + ',' : ','"
        }
      ]
    },
    {
      "name": "toggle_all_state",
      "update": "length(split(hidden_groups, ',')) - 2 < length(data('legend_groups'))"
    }
  ],
  "data": [
    {"name": "raw", "values": []},
    {
      "name": "legend_groups",
      "source": "raw",
      "transform": [
        {"type": "formula", "as": "group", "expr": "groupField ? ''+datum[groupField] : ''+datum.sample"},
        {"type": "filter", "expr": "isValid(datum[groupField]) && datum.group !== 'null' && datum.group !== 'undefined' && datum.group !== 'None'"},
        {"type": "aggregate", "groupby": ["group"]}
      ]
    },
    {
      "name": "raw_filtered",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "metricField && datum.metric === metricField"},
        {"type": "formula", "as": "group", "expr": "groupField && metricField ? ''+datum[groupField] : ''+datum.sample"},
        {"type": "filter", "expr": "isValid(datum[groupField]) && datum.group !== 'null' && datum.group !== 'undefined' && datum.group !== 'None'"},
        {"type": "formula", "as": "observed", "expr": "datum.observed"}
      ]
    },
    {
      "name": "stats",
      "source": "raw_filtered",
      "transform": [
        {"type": "filter", "expr": "indexof(hidden_groups, ',' + datum.group + ',') < 0"},
        {
          "type": "aggregate",
          "groupby": ["group", "read_depth"],
          "ops": ["median", "q1", "q3", "min", "max"],
          "fields": ["observed", "observed", "observed", "observed", "observed"],
          "as": ["median", "q1", "q3", "min", "max"]
        }
      ]
    },
    {"name": "knee_points", "values": []},
    {
      "name": "selected_knee",
      "source": "knee_points",
      "transform": [{"type": "filter", "expr": "datum.metric === metricField"}]
    },
    {"name": "samples", "values": []},
    {
      "name": "samples_flat",
      "source": "samples",
      "transform": [
        {"type": "flatten", "fields": ["all_depths"], "as": ["depth"]},
        {"type": "formula", "as": "group", "expr": "''+datum[groupField]"},
        {"type": "filter", "expr": "isValid(datum[groupField]) && datum.group !== 'null' && datum.group !== 'undefined' && datum.group !== 'None'"},
        {"type": "filter", "expr": "datum.reads >= datum.depth"},
        {"type": "filter", "expr": "indexof(hidden_groups, ',' + datum.group + ',') < 0"}
      ]
    },
    {
      "name": "samples_at_depth",
      "source": "samples_flat",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["group", "depth"],
          "ops": ["count"],
          "as": ["sample_count"]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "legend_groups", 
        "field": "group",
        "sort": {"field": "group", "op": "min"}
      },
      "range": {"scheme": "category10"}
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "upper_plot",
      "encode": {
        "enter": {
          "x": {"value": 5},
          "y": {"value": 15},
          "height": {"value": 400}
        },
        "update": {
          "width": {"signal": "width"}
        }
      },
      "scales": [
        {
          "name": "x1",
          "type": "linear",
          "domain": {"data": "raw_filtered", "field": "read_depth"},
          "range": "width"
        },
        {
          "name": "y1",
          "type": "linear",
          "domain": {"data": "raw_filtered", "field": "observed"},
          "range": "height"
        }
      ],
      "axes": [
        {"scale": "x1", "orient": "bottom", "title": {"signal": "x_axis_title"}},
        {"scale": "y1", "orient": "left", "title": {"signal": "metricField"}}
      ],
      "marks": [
        {
          "type": "rect",
          "from": {"data": "stats"},
          "encode": {
            "update": {
              "x": {"scale": "x1", "field": "read_depth", "offset": -6},
              "x2": {"scale": "x1", "field": "read_depth", "offset": 6},
              "y": {"scale": "y1", "field": "q3"},
              "y2": {"scale": "y1", "field": "q1"},
              "stroke": {"scale": "color", "field": "group"},
              "fill": {"value": null}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "stats"},
          "encode": {
            "update": {
              "x": {"scale": "x1", "field": "read_depth"},
              "y": {"scale": "y1", "field": "min"},
              "y2": {"scale": "y1", "max": null, "field": "max"},
              "stroke": {"scale": "color", "field": "group"}
            }
          }
        },
        {
          "type": "group",
          "from": {
            "facet": {
              "name": "faceted_lines",
              "data": "stats",
              "groupby": "group"
            }
          },
          "marks": [
            {
              "type": "line",
              "from": {"data": "faceted_lines"},
              "encode": {
                "update": {
                  "x": {"scale": "x1", "field": "read_depth"},
                  "y": {"scale": "y1", "field": "median"},
                  "stroke": {"scale": "color", "field": "group"},
                  "strokeWidth": {"value": 1}
                }
              }
            }
          ]
        },
        {
          "type": "rule",
          "encode": {
            "enter": {
              "y": {"value": 0},
              "y2": {"signal": "height"},
              "stroke": {"value": "red"},
              "strokeWidth": {"value": 2}
            },
            "update": {"x": {"scale": "x1", "signal": "knee_point"}}
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "lower_plot",
      "encode": {
        "enter": {
          "x": {"value": 5},
          "y": {"value": 525},
          "height": {"value": 400}
        },
        "update": {
          "width": {"signal": "width"}
        }
      },
      "scales": [
        {
          "name": "x2",
          "type": "linear",
          "domain": {"data": "raw_filtered", "field": "read_depth"},
          "nice": true,
          "range": "width"
        },
        {
          "name": "y2",
          "type": "linear",
          "domain": {"data": "samples_at_depth", "field": "sample_count"},
          "nice": true,
          "range": "height"
        }
      ],
      "axes": [
        {"scale": "x2", "orient": "bottom", "title": {"signal": "x_axis_title"}},
        {"scale": "y2", "orient": "left", "title": "Number of Samples"}
      ],
      "marks": [
        {
          "type": "group",
          "from": {
            "facet": {
              "name": "faceted_lower",
              "data": "samples_at_depth",
              "groupby": "group"
            }
          },
          "marks": [
            {
              "type": "line",
              "from": {"data": "faceted_lower"},
              "encode": {
                "update": {
                  "x": {"scale": "x2", "field": "depth"},
                  "y": {"scale": "y2", "field": "sample_count"},
                  "stroke": {"scale": "color", "field": "group"},
                  "strokeWidth": {"value": 1}
                }
              }
            },
            {
              "type": "symbol",
              "from": {"data": "faceted_lower"},
              "encode": {
                "update": {
                  "x": {"scale": "x2", "field": "depth"},
                  "y": {"scale": "y2", "field": "sample_count"},
                  "fill": {"scale": "color", "field": "group"},
                  "size": {"value": 20}
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "select_all_btn",
      "interactive": true,
      "encode": {
        "enter": {
          "font": {"value": "system-ui, -apple-system, sans-serif"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "x": {"signal": "width", "offset": 70},
          "y": {"value": -20},
          "text": {"signal": "toggle_all_state ? '☐ Deselect All Samples' : '☑ Select All Samples'"},
          "fill": {"signal": "toggle_all_state ? '#007bff' : '#6c757d'"}
        },
        "hover": {
          "fill": {"value": "#0056b3"}
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Legend",
      "orient": "right",
      "legendY": 15,
      "columns": 1,
      "symbolLimit": 1000,
      "labelLimit": 100,
      "minExtent": 400,
      "maxExtent": 400,
      "encode": {
        "symbols": {
          "name": "group_legend_symbols",
          "interactive": true,
          "update": {
            "size": {"value": 100},
            "opacity": {"signal": "indexof(hidden_groups, ',' + datum.value + ',') >= 0 ? 0.2 : 1"}
          }
        },
        "labels": {
          "name": "group_legend_labels",
          "interactive": true,
          "update": {
            "fontSize": {"value": 12},
            "opacity": {"signal": "indexof(hidden_groups, ',' + datum.value + ',') >= 0 ? 0.4 : 1"}
          }
        }
      }
    }
  ],
  "config": {
    "axis": {
      "titleFontSize": 16,
      "labelFontSize": 14,
      "domainWidth": 2,
      "tickWidth": 2,
      "titlePadding": 10
    },
    "legend": {
      "titleFontSize": 16,
      "labelFontSize": 14,
      "offset": 50
    }
  }
}